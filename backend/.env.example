# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://thinkora:password@localhost:5432/thinkora_db

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-too

# ─── AI (Anthropic) ─────────────────────────────────────────────────────────
# Powers AI challenge generation and AI coach
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://app.thinkora.ai

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
